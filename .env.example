# Database
DB_HOST=localhost
DB_PORT=1433
DB_NAME=QLBanMayTinh
DB_USER=sa
DB_PASSWORD=change-me-Strong@Password1

# JWT (tối thiểu 32 ký tự — tạo bằng: openssl rand -hex 32)
JWT_SECRET=your-very-secure-and-long-secret-key-at-least-32-characters-here
JWT_EXPIRATION=86400000

# Firebase Admin SDK — để file JSON NGOÀI thư mục source code
# Ví dụ: FIREBASE_SERVICE_ACCOUNT=C:/secrets/saoclub-firebase.json
FIREBASE_SERVICE_ACCOUNT=classpath:firebase-service-account.json

# Upload
UPLOAD_DIR=../FrontEnd/QLBanMayTinh/public/images

# CORS (comma-separated, no spaces)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Chỉ đặt true khi backend đứng sau reverse proxy tin cậy (Nginx/Cloudflare)
SECURITY_RATE_LIMIT_TRUST_FORWARDED_HEADER=false

